{
  "info": {
    "name": "EDTECH Platform API",
    "_postman_id": "c7f2e2f9-2d77-4b83-a4a3-edtech-api-001",
    "description": "Postman Collection for full EdTech Platform backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "item": [

    {
      "name": "AUTH",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n \"name\": \"Test User\",\n \"email\": \"test@example.com\",\n \"password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/signup"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n \"email\": \"test@example.com\",\n \"password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },

    {
      "name": "USERS",
      "item": [
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Updated User\" }"
            },
            "url": "{{base_url}}/users/update"
          }
        }
      ]
    },

    {
      "name": "COURSES",
      "item": [
        {
          "name": "Create Course (Admin/Teacher)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Physics Class 9\", \"description\": \"Full syllabus\" }"
            },
            "url": "{{base_url}}/courses"
          }
        },
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses"
          }
        },
        {
          "name": "Get Course By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{courseId}}"
          }
        }
      ]
    },

    {
      "name": "CHAPTERS",
      "item": [
        {
          "name": "Create Chapter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Chapter 1\", \"courseId\": \"{{courseId}}\" }"
            },
            "url": "{{base_url}}/chapters"
          }
        },
        {
          "name": "Get Chapters by Course",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/chapters/by-course/{{courseId}}"
          }
        }
      ]
    },

    {
      "name": "LESSONS",
      "item": [
        {
          "name": "Create Lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Introduction\", \"chapterId\": \"{{chapterId}}\", \"videoUrl\": \"https://video.com/a.mp4\" }"
            },
            "url": "{{base_url}}/lessons"
          }
        },
        {
          "name": "Get Lessons by Chapter",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/lessons/by-chapter/{{chapterId}}"
          }
        }
      ]
    },

    {
      "name": "QUIZ",
      "item": [
        {
          "name": "Create Quiz",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Chapter 1 Quiz\", \"lessonId\": \"{{lessonId}}\", \"questions\": [] }"
            },
            "url": "{{base_url}}/quiz"
          }
        },
        {
          "name": "Submit Quiz Result",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"quizId\": \"{{quizId}}\", \"answers\": [] }"
            },
            "url": "{{base_url}}/quiz/submit"
          }
        }
      ]
    },

    {
      "name": "REVIEWS",
      "item": [
        {
          "name": "Add Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"courseId\": \"{{courseId}}\", \"rating\": 5, \"comment\": \"Great!\" }"
            },
            "url": "{{base_url}}/reviews"
          }
        },
        {
          "name": "Get Reviews",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reviews/{{courseId}}"
          }
        }
      ]
    },

    {
      "name": "PAYMENTS",
      "item": [
        {
          "name": "Create Order (Razorpay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"courseId\": \"{{courseId}}\" }"
            },
            "url": "{{base_url}}/payments/create-order"
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"orderId\": \"string\", \"paymentId\": \"string\", \"signature\": \"string\" }"
            },
            "url": "{{base_url}}/payments/verify"
          }
        }
      ]
    },

    {
      "name": "NOTIFICATIONS",
      "item": [
        {
          "name": "Get User Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/notifications"
          }
        }
      ]
    },

    {
      "name": "LIVE CLASS",
      "item": [
        {
          "name": "Create Live Class",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacher_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Maths Live Session\", \"courseId\": \"{{courseId}}\" }"
            },
            "url": "{{base_url}}/live"
          }
        },
        {
          "name": "Get Live Classes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/live"
          }
        }
      ]
    }

  ],

  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "teacher_token", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "chapterId", "value": "" },
    { "key": "lessonId", "value": "" },
    { "key": "quizId", "value": "" }
  ]
}
